# Without Docker: copy to .env.local. With Docker use ../.env.example instead.
# Secrets without a VITE_ prefix; never put real keys here.
VITE_LANDING_URL=http://localhost:5174/
VITE_ENABLE_DEVTOOLS=false
VITE_EDITION=oss

# Mode: empty = showcase + import of your own projects; showcase = sample data only
# (same as npm run dev:showcase).
# NEURALDOC_MODE=
# Storage for imported projects, decisions and caches (default: mcp/state).
# NEURALDOC_STATE_DIR=

# Required for your own projects: Jev for component and document mapping.
TYPESAFE_API_KEY=
NEURALDOC_JEV_BUDGET_USD=0.25

# Choose one LLM: openai | anthropic (or claude) | local | gemini | vertex.
NEURALDOC_DRAFT_PROVIDER=openai
NEURALDOC_LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

# Claude: provider=anthropic, model=claude-haiku-4-5
# ANTHROPIC_API_KEY=

# Local: provider=local, model=name of the loaded model, e.g. qwen2.5:7b
# NEURALDOC_LLM_BASE_URL=http://127.0.0.1:11434/v1
# NEURALDOC_LLM_API_KEY=
# NEURALDOC_LLM_FORMAT=json_schema
# For a server without JSON schema support, use json_object explicitly.

# Gemini Developer API: provider=gemini, model=gemini-2.5-flash-lite
# GEMINI_API_KEY=

# Vertex: provider=vertex, model=gemini-2.5-flash-lite
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
# NEURALDOC_VERTEX_AUTH=api-key
# NEURALDOC_VERTEX_MODE=express
# VERTEX_API_KEY=

# Optional rates in USD per 1M tokens. Without rates, cloud costs stay unknown.
# NEURALDOC_LLM_INPUT_USD_PER_MILLION=
# NEURALDOC_LLM_OUTPUT_USD_PER_MILLION=

# Optional separate backend (not needed for the LLM connection).
# BACKEND_PROXY_TARGET=http://127.0.0.1:8000
# VITE_API_BASE_URL=/api
