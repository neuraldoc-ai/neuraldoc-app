# In .env.local kopieren. Secrets ohne VITE_-Präfix; keine echten Keys hier eintragen.
VITE_LANDING_URL=http://localhost:5173/
VITE_ENABLE_DEVTOOLS=false
VITE_EDITION=oss

# Betriebsart: leer = Showcase + Import eigener Projekte; showcase = nur Beispieldaten
# (gleichbedeutend mit npm run dev:showcase).
# NEURALDOC_MODE=
# Ablage für importierte Projekte, Entscheidungen und Caches (Standard: mcp/state).
# NEURALDOC_STATE_DIR=

# Pflicht für eigene Projekte: Jev für fachliche Komponenten-/Dokumentzuordnung.
TYPESAFE_API_KEY=
NEURALDOC_JEV_BUDGET_USD=0.25

# Ein LLM wählen: openai | anthropic (oder claude) | local | gemini | vertex.
NEURALDOC_DRAFT_PROVIDER=openai
NEURALDOC_LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

# Claude: provider=anthropic, model=claude-haiku-4-5
# ANTHROPIC_API_KEY=

# Lokal: provider=local, model=Name des geladenen Modells, z.B. qwen2.5:7b
# NEURALDOC_LLM_BASE_URL=http://127.0.0.1:11434/v1
# NEURALDOC_LLM_API_KEY=
# NEURALDOC_LLM_FORMAT=json_schema
# Bei einem Server ohne JSON-Schema-Unterstützung ausdrücklich json_object verwenden.

# Gemini Developer API: provider=gemini, model=gemini-2.5-flash-lite
# GEMINI_API_KEY=

# Vertex: provider=vertex, model=gemini-2.5-flash-lite
# GOOGLE_CLOUD_PROJECT=deine-projekt-id
# GOOGLE_CLOUD_LOCATION=global
# NEURALDOC_VERTEX_AUTH=api-key
# NEURALDOC_VERTEX_MODE=express
# VERTEX_API_KEY=

# Optionale Tarife in USD je 1 Mio. Tokens. Ohne Tarife bleiben Cloud-Kosten unbekannt.
# NEURALDOC_LLM_INPUT_USD_PER_MILLION=
# NEURALDOC_LLM_OUTPUT_USD_PER_MILLION=

# Optionales separates Backend (für die LLM-Anbindung nicht nötig).
# BACKEND_PROXY_TARGET=http://127.0.0.1:8000
# VITE_API_BASE_URL=/api
