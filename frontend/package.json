{
  "name": "neuraldoc-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "brain:index": "node ../mcp/build-brain.mjs",
    "brain:map": "node --use-system-ca ../mcp/build-brain.mjs --jev",
    "brain:test": "node --test ../mcp/brain.test.mjs ../mcp/code-analysis.test.mjs ../mcp/semantic-mapping.test.mjs",
    "brain:evaluate": "node --use-system-ca ../mcp/mapping-evaluation.mjs --live",
    "brain:report": "node ../mcp/mapping-report.mjs",
    "dev": "node --use-system-ca node_modules/vite/bin/vite.js",
    "dev:showcase": "node --use-system-ca node_modules/vite/bin/vite.js --mode showcase",
    "start": "node --use-system-ca --env-file-if-exists=.env.local ../mcp/serve.mjs",
    "start:showcase": "node --use-system-ca --env-file-if-exists=.env.local --env-file=.env.showcase ../mcp/serve.mjs",
    "build": "tsc -b && vite build",
    "build:app": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "mcp": "node --use-system-ca --env-file-if-exists=.env.local ../mcp/http.mjs",
    "mcp:stdio": "node --use-system-ca --env-file-if-exists=.env.local ../mcp/stdio.mjs",
    "test": "node --test \"../mcp/*.test.mjs\""
  },
  "dependencies": {
