# Optional: keys can also be entered in the app (Einstellungen); those win.
# Keys for checking your own projects. Copy to .env and pass it with
#   docker run --env-file .env ...
# Without Docker, put the same lines into frontend/.env.local.
# .env is ignored by Git; never commit real keys.

# Empty = showcase + import of your own projects; showcase = sample data only.
NEURALDOC_MODE=

# Required for your own projects: Jev maps documents to the changed code.
TYPESAFE_API_KEY=
NEURALDOC_JEV_BUDGET_USD=0.25

# One LLM drafts the text changes: openai | anthropic | local | gemini | vertex.
NEURALDOC_DRAFT_PROVIDER=openai
NEURALDOC_LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

# Claude: NEURALDOC_DRAFT_PROVIDER=anthropic, NEURALDOC_LLM_MODEL=claude-haiku-4-5
# ANTHROPIC_API_KEY=

# Gemini: NEURALDOC_DRAFT_PROVIDER=gemini, NEURALDOC_LLM_MODEL=gemini-3.5-flash-lite
# GEMINI_API_KEY=

# Local LLM (Ollama, LM Studio): NEURALDOC_DRAFT_PROVIDER=local, NEURALDOC_LLM_MODEL=<loaded model>
# From inside Docker the host is host.docker.internal, not 127.0.0.1.
# NEURALDOC_LLM_BASE_URL=http://host.docker.internal:11434/v1
# NEURALDOC_LLM_API_KEY=

# Vertex AI and all other options: see frontend/.env.example.
