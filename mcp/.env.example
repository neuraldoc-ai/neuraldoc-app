# Server only. For Vite, set the same values in frontend/.env.local.
NEURALDOC_DRAFT_PROVIDER=vertex
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
NEURALDOC_VERTEX_AUTH=api-key
NEURALDOC_VERTEX_MODE=express
VERTEX_API_KEY=
NEURALDOC_GEMINI_MODEL=gemini-2.5-flash-lite
# Gemini 2.5 Flash-Lite: thinking explicitly off.
# Alternatively gemini-3.5-flash-lite with minimal thinking.
# Gemini Developer API only explicitly: NEURALDOC_DRAFT_PROVIDER=gemini and GEMINI_API_KEY.
# No automatic switch to more expensive models.
