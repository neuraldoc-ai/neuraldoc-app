# Nur serverseitig. Für Vite dieselben Werte in frontend/.env.local setzen.
NEURALDOC_DRAFT_PROVIDER=vertex
GOOGLE_CLOUD_PROJECT=deine-projekt-id
GOOGLE_CLOUD_LOCATION=global
NEURALDOC_VERTEX_AUTH=api-key
NEURALDOC_VERTEX_MODE=express
VERTEX_API_KEY=
NEURALDOC_GEMINI_MODEL=gemini-2.5-flash-lite
# Konservative Tagesreservierung in USD, je Serverprozess mit gemeinsamem lokalen Zustand.
# Gemini 2.5 Flash-Lite: Thinking explizit aus.
# Alternativ gemini-3.5-flash-lite mit minimalem Thinking.
# Gemini Developer API nur explizit: NEURALDOC_DRAFT_PROVIDER=gemini und GEMINI_API_KEY.
# Keine automatische Umschaltung auf teurere Modelle.
